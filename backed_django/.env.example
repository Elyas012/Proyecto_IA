# Django Configuration
SECRET_KEY=your-secret-key-here-change-this-in-production
DEBUG=False
ALLOWED_HOSTS=your-railway-domain.railway.app,localhost

# Database Configuration (Railway MySQL)
DB_ENGINE=django.db.backends.mysql
DB_NAME=proyecto_ia
DB_USER=root
DB_PASSWORD=your_password
DB_HOST=your-railway-db-host
DB_PORT=3306

# CORS Configuration (Update with your Vercel domain)
CORS_ALLOWED_ORIGINS=https://your-vercel-app.vercel.app,http://localhost:3000

# Google OAuth Configuration
# Obtén estas credenciales en: https://console.cloud.google.com/apis/credentials
GOOGLE_OAUTH_CLIENT_ID=tu-client-id-aqui.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=tu-client-secret-aqui
GOOGLE_OAUTH_REDIRECT_URI=https://your-vercel-app.vercel.app/auth/callback

# Facebook OAuth Configuration
# Obtén estas credenciales en: https://developers.facebook.com/apps/
FACEBOOK_APP_ID=tu-facebook-app-id-aqui
FACEBOOK_APP_SECRET=tu-facebook-app-secret-aqui

# Google Generative AI API Key
GEMINI_API_KEY=tu-gemini-api-key-aqui
