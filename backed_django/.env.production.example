# Production Environment - Railway
# NOTA: No subas este archivo a GitHub. Usa Railway's Environment Variables panel.

SECRET_KEY=generated-secret-key-do-not-use-default
DEBUG=False
ALLOWED_HOSTS=your-railway-domain.railway.app

# Database MySQL en Railway
DB_ENGINE=django.db.backends.mysql
DB_NAME=railway_database_name
DB_USER=railway_user
DB_PASSWORD=your_secure_password_here
DB_HOST=containers-us-west-xxx.railway.app
DB_PORT=3306

# CORS Settings
CORS_ALLOWED_ORIGINS=https://your-vercel-app.vercel.app

# Google OAuth
GOOGLE_OAUTH_CLIENT_ID=xxx.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-google-secret
GOOGLE_OAUTH_REDIRECT_URI=https://your-vercel-app.vercel.app/auth/callback

# Facebook OAuth
FACEBOOK_APP_ID=your-facebook-id
FACEBOOK_APP_SECRET=your-facebook-secret

# Gemini API
GEMINI_API_KEY=your-gemini-key
